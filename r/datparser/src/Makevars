LIBDIR = rust/target/release
PKG_LIBS = -L$(LIBDIR) -ldatparser

all: $(SHLIB)

$(SHLIB): rustlib

# The core needs no crates from crates.io, so this builds offline.
rustlib:
	cd rust && cargo build --release --lib --offline --target-dir target

.PHONY: rustlib

clean:
	rm -rf $(SHLIB) $(OBJECTS) rust/target
