# R on Windows links with Rtools' gcc, so build the Rust library for the
# GNU target rather than rustup's default MSVC one, and compile the C of
# libzstd (zstd-sys) with that gcc too. The system libraries
# are those Rust's standard library needs on Windows.
TARGET = x86_64-pc-windows-gnu
LIBDIR = rust/target/$(TARGET)/release
PKG_LIBS = -L$(LIBDIR) -ldtaparser -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB)

$(SHLIB): rustlib

# A source package carries the crates.io crates as vendor.tar.xz, with a
# .cargo/config.toml that builds from them (scripts/build-r-package.sh);
# a checkout has neither, and cargo fetches them.
rustlib:
	if [ -f rust/vendor.tar.xz ] && [ ! -d rust/vendor ]; then cd rust && $(TAR) -xJf vendor.tar.xz; fi
	cd rust && CC_x86_64_pc_windows_gnu=gcc AR_x86_64_pc_windows_gnu=ar cargo build --release --lib --target $(TARGET) --target-dir target

.PHONY: rustlib

clean:
	rm -rf $(SHLIB) $(OBJECTS) rust/target rust/vendor
