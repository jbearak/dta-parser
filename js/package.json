{
  "name": "@jbearak/dta-parser",
  "version": "1.0.0",
  "description": "Read and write Stata .dta files",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./format": {
      "types": "./dist/format-entry.d.ts",
      "default": "./dist/format.js"
    }
  },
  "typesVersions": {
    "*": {
      "node": [
        "dist/node.d.ts"
      ],
      "format": [
        "dist/format-entry.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@^5.9.3"
  }
}
