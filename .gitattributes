# Native manifest hashes describe these text files with LF line endings.
/r-package/dtatools/tests/testthat/*.R text eol=lf
/r-package/dtatools/tests/testthat/fixtures/README.md text eol=lf
/r-package/dtatools/tests/testthat/fixtures/*.do text eol=lf
/r-package/dtatools/tests/testthat/fixtures/*.log text eol=lf
/r-package/dtatools/tests/testthat/fixtures/*.rds -text
/r-package/dtatools/tests/testthat/fixtures/*.c text eol=lf
/r-package/dtatools/tests/testthat/fixtures/*.R text eol=lf
/r-package/dtatools/tests/testthat/fixtures/*.txt text eol=lf

# Stata console spaces are part of the byte-for-byte tabulation oracles.
/r-package/dtatools/tests/testthat/fixtures/tabulate*.log whitespace=-blank-at-eol,-blank-at-eof
