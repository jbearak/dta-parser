\section{The mapping}{

\tabular{ll}{
R value \tab Stata storage \cr
\verb{dta_*()} or \code{dta_string()} result \tab Its declared storage \cr
logical \tab Stays logical; \code{\link[=save_dta]{save_dta()}} writes \code{byte} \cr
integer \tab \code{long} \cr
double \tab \code{double} \cr
\code{Date} \tab \code{float}, declared as a Stata date \cr
\code{POSIXct} \tab \code{double}, declared as a Stata datetime \cr
character \tab Smallest fitting \code{str1} through \code{str2045}, or \code{strL} \cr
factor \tab Stays a factor; \code{\link[=save_dta]{save_dta()}} writes a value-labelled \code{long} \cr
