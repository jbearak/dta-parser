+    #[test]
+    fn uncompressed_buffer_reads_stop_at_the_declared_extent() {
+        struct ShortReader {
+            source: Cursor<Vec<u8>>,
+            interrupted: bool,
+        }
+
+        impl Read for ShortReader {
+            fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+                if !self.interrupted {
+                    self.interrupted = true;
+                    return Err(io::ErrorKind::Interrupted.into());
+                }
+                let count = buffer.len().min(7);
+                self.source.read(&mut buffer[..count])
+            }
+        }
+
+        impl Seek for ShortReader {
+            fn seek(&mut self, position: SeekFrom) -> io::Result<u64> {
+                self.source.seek(position)
+            }
+        }
+
+        for length in [0, 1, 31, 32, 4096, 65_536] {
+            let payload: Vec<u8> = (0..length).map(|index| index as u8).collect();
+            let mut bytes = vec![0x9f; 5];
+            bytes.extend_from_slice(&payload);
+            bytes.extend_from_slice(&[0xcd; 16]);
+            let mut reader = ShortReader {
+                source: Cursor::new(bytes),
+                interrupted: false,
+            };
+            let buffer = read_ipc_buffer(
+                &mut reader,
+                2,
+                length as u64 + 19,
+                (3, length as u64),
+                None,
+                length,
+            )
+            .expect("short reads and Interrupted preserve the exact buffer");
+            assert_eq!(buffer.as_slice(), payload);
+            assert_eq!(reader.source.position(), length as u64 + 5);
+            assert_eq!(reader.interrupted, length != 0);
+        }
+    }
+
+    #[test]
+    fn uncompressed_buffer_preserves_truncation_and_other_io_errors() {
+        let mut truncated = Cursor::new([1_u8, 2, 3]);
+        let error = read_ipc_buffer(&mut truncated, 0, 4, (0, 4), None, 4)
+            .expect_err("a short buffer cannot be published");
+        assert!(matches!(error, ArrowProfileError::Io(error)
+            if error.kind() == io::ErrorKind::UnexpectedEof));
+
+        struct FailedReader(Cursor<Vec<u8>>);
+
+        impl Read for FailedReader {
+            fn read(&mut self, _: &mut [u8]) -> io::Result<usize> {
+                Err(io::Error::other("buffer read failed"))
+            }
+        }
+
+        impl Seek for FailedReader {
+            fn seek(&mut self, position: SeekFrom) -> io::Result<u64> {
+                self.0.seek(position)
+            }
+        }
+
+        let mut failed = FailedReader(Cursor::new(Vec::new()));
+        let error = read_ipc_buffer(&mut failed, 0, 4, (0, 4), None, 4)
+            .expect_err("the underlying read error must propagate");
+        assert!(matches!(error, ArrowProfileError::Io(error)
+            if error.kind() == io::ErrorKind::Other && error.to_string() == "buffer read failed"));
+    }
