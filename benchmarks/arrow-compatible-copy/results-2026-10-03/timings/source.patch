+    #[test]
+    fn compatible_double_fills_preserve_every_bit_across_sliced_chunks() {
+        let mut bits = vec![
+            0,
+            1,
+            1 << 63,
+            f64::MAX.to_bits(),
+            f64::MIN.to_bits(),
+            f64::MIN_POSITIVE.to_bits(),
+            f64::INFINITY.to_bits(),
+            f64::NEG_INFINITY.to_bits(),
+            0x7ff0_0000_0000_0001,
+            0x7ff8_1234_5678_abcd,
+            0xfff8_abcd_1234_5678,
+        ];
+        bits.extend(
+            (0..27).map(|rank| r_missing(MissingTag::from_offset(rank).unwrap()).to_bits()),
+        );
+        let mut padded = vec![13.0, 17.0];
+        padded.extend(bits.iter().copied().map(f64::from_bits));
+        padded.push(19.0);
+        let source: ArrayRef = Arc::new(Float64Array::from(padded));
+        let column = primitive_column(
+            DataType::Float64,
+            vec![
+                source.slice(2, 7),
+                source.slice(0, 0),
+                source.slice(9, 1),
+                source.slice(10, bits.len() - 8),
+            ],
+        );
+        let poison = 0x7ff8_dead_beef_0001;
+        let fills: [unsafe fn(&ArrowReadColumn, *mut f64) -> Result<(), String>; 2] =
+            [fill_semantic_double, fill_payload_double];
+        for fill in fills {
+            let mut output = vec![f64::from_bits(poison); bits.len() + 2];
+            unsafe { fill(&column, output.as_mut_ptr().add(1)).unwrap() };
+            assert_eq!(output[0].to_bits(), poison);
+            assert_eq!(output[bits.len() + 1].to_bits(), poison);
+            assert_eq!(
+                output[1..bits.len() + 1]
+                    .iter()
+                    .map(|x| x.to_bits())
+                    .collect::<Vec<_>>(),
+                bits
+            );
+            output[1] = 123.0;
+            let original = source.as_any().downcast_ref::<Float64Array>().unwrap();
+            assert_eq!(
+                original.values()[2..bits.len() + 2]
+                    .iter()
+                    .map(|x| x.to_bits())
+                    .collect::<Vec<_>>(),
+                bits
+            );
+        }
+    }
