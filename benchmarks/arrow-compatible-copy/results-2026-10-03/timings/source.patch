+    #[test]
+    fn compatible_double_fills_keep_nullable_and_payload_policies() {
+        let bits = [
+            0,
+            1,
+            2,
+            (1u64 << 63),
+            0x7ff8_1111_2222_3333,
+            5,
+            6,
+            7,
+            0xfff8_4444_5555_6666,
+            9,
+            10,
+            11,
+        ];
+        let valid = vec![
+            true, true, true, true, false, true, true, true, false, true, true, true,
+        ];
+        let source: ArrayRef = Arc::new(Float64Array::new(
+            ScalarBuffer::from(bits.map(f64::from_bits).to_vec()),
+            Some(arrow_buffer::NullBuffer::from(valid.clone())),
+        ));
+        let column = primitive_column(
+            DataType::Float64,
+            vec![
+                source.slice(3, 4),
+                source.slice(0, 0),
+                source.slice(7, 3),
+                source.slice(10, 2),
+            ],
+        );
+        let mut semantic = vec![0.0; 9];
+        let mut payload = vec![0.0; 9];
+        unsafe {
+            fill_semantic_double(&column, semantic.as_mut_ptr()).unwrap();
+            fill_payload_double(&column, payload.as_mut_ptr()).unwrap();
+        }
+        let expected: Vec<_> = (3..12)
+            .map(|index| {
+                if valid[index] {
+                    bits[index]
+                } else {
+                    TEST_R_NA_REAL.to_bits()
+                }
+            })
+            .collect();
+        assert_eq!(
+            semantic.iter().map(|x| x.to_bits()).collect::<Vec<_>>(),
+            expected
+        );
+        // Public payload profiles reject nulls before this fill. Preserve the
+        // existing pure fill's physical-value fallback rather than changing it.
+        assert_eq!(
+            payload.iter().map(|x| x.to_bits()).collect::<Vec<_>>(),
+            bits[3..]
+        );
+        let mut visited = 0;
+        unsafe {
+            fill_compatible_primitive::<Float64Type>(
+                &column,
+                payload.as_mut_ptr(),
+                |values, index| {
+                    visited += 1;
+                    values.value(index)
+                },
+            )
+            .unwrap();
+        }
+        // The last slice has an all-valid bitmap and copies without visiting
+        // the scalar policy. The two null-bearing slices have seven rows.
+        assert_eq!(visited, 7);
+    }
