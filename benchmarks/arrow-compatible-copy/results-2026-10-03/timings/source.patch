+/// Fill physically compatible primitive chunks into an independent R vector.
+/// The existing ColumnFill contract keeps the Arrow arrays alive and gives
+/// this worker an aligned output buffer with room for every selected row.
+/// Null-bearing chunks retain their route's scalar value policy.
+unsafe fn fill_compatible_primitive<T: ArrowPrimitiveType>(
+    column: &ArrowReadColumn,
+    output: *mut T::Native,
+    mut nullable_value: impl FnMut(&PrimitiveArray<T>, usize) -> T::Native,
+) -> Result<(), String> {
+    let mut row = 0usize;
+    for chunk in &column.chunks {
+        let typed = chunk
+            .as_any()
+            .downcast_ref::<PrimitiveArray<T>>()
+            .ok_or_else(|| chunk_error(&column.name))?;
+        // Empty R vectors may provide sentinel pointers. Skip even a zero-
+        // length raw copy and its destination pointer arithmetic.
+        if typed.is_empty() {
+            continue;
+        }
+        if typed.null_count() == 0 {
+            // values() already includes the selected ScalarBuffer offset.
+            // The R destination was allocated independently before workers.
+            ptr::copy_nonoverlapping(typed.values().as_ptr(), output.add(row), typed.len());
+            row += typed.len();
+        } else {
+            for index in 0..typed.len() {
+                *output.add(row) = nullable_value(typed, index);
+                row += 1;
+            }
+        }
+    }
+    Ok(())
+}
