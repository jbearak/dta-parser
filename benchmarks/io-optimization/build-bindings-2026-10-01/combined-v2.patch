+        "dtatools_write_numeric_replacement_warning"
+    ))
+    expect_match(warnings[[1L]][[2L]]$message,
+        "`amount` \\(4,096\\), `other` \\(8,193\\)")
+    expect_identical(datasig(data), before)
+})
