+                        identical(native_error$result$names, c("x", "g")))
+                }
+            }
+            stopifnot(!isNamespaceLoaded("dplyr"))
+            TRUE
+        }, args = list(stage = stage, expected = expected), libpath = .libPaths())
+        expect_true(observed, info = stage)
+    }
 })
 
