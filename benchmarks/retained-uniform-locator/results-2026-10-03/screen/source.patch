+    #[test]
+    fn chunk_geometry_preserves_sliced_buffers_and_irregular_tails() {
+        let whole = Int16Array::from((0..80_i16).collect::<Vec<_>>());
+        let cases: &[(&[usize], usize)] = &[
+            (&[], 0),
+            (&[0, 0], 0),
+            (&[7], 7),
+            (&[7, 7, 7], 7),
+            (&[7, 7, 3], 7),
+            (&[0, 7, 0, 7, 0, 3, 0], 7),
+            (&[3, 7, 7], 0),
+            (&[7, 3, 7], 0),
+            (&[7, 7, 8], 0),
+        ];
+        for &(lengths, expected_uniform) in cases {
+            let mut arrays: Vec<ArrayRef> = Vec::new();
+            let mut expected = Vec::new();
+            let mut rows = 0;
+            for (position, &length) in lengths.iter().enumerate() {
+                let offset = [40, 2, 20][position % 3];
+                arrays.push(Arc::new(whole.slice(offset, length)));
+                if length != 0 {
+                    let pointer = whole.values().as_ptr().wrapping_add(offset).cast::<u8>();
+                    expected.push((rows, rows + length, pointer));
+                    rows += length;
+                }
+            }
+            let data = prepare_from_arrow(
+                &arrays,
+                NumericKind::Int,
+                TemporalKind::None,
+                FormatVersion::V118,
+                rows,
+                || false,
+            )
+            .unwrap()
+            .into_descriptor();
+            let owner = unsafe { &*data.native_owner.cast::<Owner>() };
+            assert_eq!(owner.uniform_rows, expected_uniform, "{lengths:?}");
+            drop(arrays);
+            for index in (0..rows).rev().chain((0..rows).step_by(3)) {
+                let &(start, end, pointer) = expected
+                    .iter()
+                    .find(|&&(a, b, _)| a <= index && index < b)
+                    .unwrap();
+                assert_eq!(
+                    unsafe { scalar_span(&data, index) },
+                    Some((pointer, start, end))
+                );
+                assert_eq!(
+                    owner.region(index, usize::MAX),
+                    Some((pointer.wrapping_add((index - start) * 2), end - index))
+                );
+            }
+            assert_eq!(owner.region(rows, usize::MAX), Some((ptr::null(), 0)));
+            assert_eq!(owner.region(rows + 1, 0), None);
+            assert!(unsafe { scalar_span(&data, rows) }.is_none());
+        }
+    }
+
+    #[test]
+    fn uniform_lookup_preserves_owner_and_descriptor_bounds() {
+        let bytes = [0_u8; 17];
+        for chunk_rows in [1, 7, 19, usize::MAX] {
+            let descriptor = unsafe {
+                dtatools_owned_numeric_from_raw(
+                    bytes.as_ptr(),
+                    bytes.len(),
+                    chunk_rows,
+                    NumericKind::Byte as c_int,
+                    0,
+                    118,
+                    0,
+                )
+            };
+            assert!(!descriptor.is_null());
+            let mut data = unsafe { Box::from_raw(descriptor.cast::<NumericData>()) };
+            let owner = unsafe { &*data.native_owner.cast::<Owner>() };
+            assert_eq!(owner.uniform_rows, chunk_rows);
+            data.length = 5;
+            assert!(unsafe { scalar_span(&data, 5) }.is_none());
+            // Bulk owner regions retain their existing owner-length contract.
+            let (mut pointer, mut count) = (ptr::null(), 0);
+            assert_eq!(
+                unsafe {
+                    dtatools_owned_numeric_region(
+                        (&*data as *const NumericData).cast(),
+                        16,
+                        usize::MAX,
+                        &mut pointer,
+                        &mut count,
+                    )
+                },
+                1
+            );
+            assert_eq!(
+                (pointer.cast::<u8>(), count),
+                (bytes.as_ptr().wrapping_add(16), 1)
+            );
+            assert_eq!(owner.region(usize::MAX, 1), None);
         }
     }
 
