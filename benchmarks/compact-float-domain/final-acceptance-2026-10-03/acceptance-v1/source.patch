+    ) {                                                                    \
+        (void) policy;                                                     \
+        float value;                                                       \
+        memcpy(&value, raw + index * sizeof(value), sizeof(value));         \
+        return (arithmetic_pair_value) {                                  \
+            (double) value, (unsigned) (MISSING), 0,                        \
+            (unsigned) (value == 0), value                                 \
+        };                                                                 \
+    }
