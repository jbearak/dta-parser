+                let right = view(&y, yv);
+                for op in 0..=5 {
+                    let expected: Vec<c_int> = (0..x.len())
+                        .map(|i| unsafe {
+                            compare_decoded(
+                                op,
+                                compare_operand_element(left, i).unwrap(),
+                                compare_operand_element(right, i).unwrap(),
