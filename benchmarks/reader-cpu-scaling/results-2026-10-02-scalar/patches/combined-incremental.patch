+        testthat::expect_identical(owned_scalar_sum(proxy), 9)
+        testthat::expect_identical(calls, 0L)
+        testthat::expect_error(classes[[1L]], "foreign scalar class metadata callback")
+        testthat::expect_identical(calls, 1L)
+    })
