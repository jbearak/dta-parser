+        else if (reader->temporal == 2) value = (value + 315619200.0) * 1000.0;
+        if (!R_FINITE(value) || fabs(value) > DBL_MAX / 2.0) {
+            Rf_error("Calculation input cannot be represented by Stata double storage");
+        }
+    }
