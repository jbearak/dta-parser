+                         integer(), c(2L, 3L), NA_real_, Inf, list(5))
+    for (replacement in replacements) {
+        expect_identical(
+            .numeric_match_capture(dta_match(c(1, 2), 1, replacement)),
+            .numeric_match_capture(.numeric_match_reference(c(1, 2), 1, replacement))
