+.native_legacy_mean <- function(x, ..., na.rm = FALSE) {
+    result <- suppressWarnings(mean(dtatools:::.dta_data(x), ..., na.rm = na.rm))
+    dtatools:::.dta_computed(dtatools:::.collapse_missing(result),
+                            dtatools:::.declared_dta_storage(x))
+}
