      "sha256": "3ea7f37d5e369809bec6a2b0f09d846480c3210ece09ca271095c6ade2879145",
      "text": "static int byte_missing_offset(int8_t value, int format_version) {\n    if (format_version <= 111) return value == 127 ? 0 : -1;\n    return value >= 101 && value <= 127 ? value - 101 : -1;\n}\n"
    },
    "int_missing_offset": {
      "sha256": "2affd1c1f0f349eaea4aa3fb8bb753d389b262f0342524db87f561ceae3ab9ff",
      "text": "static int int_missing_offset(int16_t value, int format_version) {\n    if (format_version <= 111) return value == 32767 ? 0 : -1;\n    return value >= 32741 && value <= 32767 ? value - 32741 : -1;\n}\n"
    },
    "float_missing_offset": {
      "sha256": "e6fa58c6d59d492446ead80c85c0f36b5afd76a26af2ddcab67a4563b105691e",
      "text": "static int float_missing_offset(float value, int format_version) {\n    uint32_t bits;\n    memcpy(&bits, &value, sizeof(bits));\n    if (format_version <= 111) {\n        return bits >= UINT32_C(0x7f000000) && bits < UINT32_C(0x80000000)\n            ? 0 : -1;\n    }\n    if (bits < UINT32_C(0x7f000000) || bits > UINT32_C(0x7f00d000)) {\n        return -1;\n    }\n    uint32_t delta = bits - UINT32_C(0x7f000000);\n    return delta % UINT32_C(0x00000800) == 0\n        ? (int) (delta / UINT32_C(0x00000800)) : -1;\n}\n"
    }
