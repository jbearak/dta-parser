+        values <- suppressWarnings(operation(arguments[[1L]], arguments[[2L]]))
+        values[is.na(arguments[[1L]]) | is.na(arguments[[2L]])] <- NA_real_
+        expected <- dtatools:::.dta_computed(values, minimum)
